<?xml version="1.0" ?>
<!--
rrstack RoboRacer Gazebo (Ignition) integration.
Author of rrstack modifications: Sai Tarun Bhyri
Copyright (c) 2026 AVAI Team, Chair of Software Engineering, Ruhr University Bochum

Ignition (Fortress) SDF model for the F110 RoboRacer car.
This is the Ignition-native equivalent of f110_car.urdf. It is the model
that gets spawned into Ignition Gazebo; the URDF is kept only for
robot_state_publisher (TF tree of the static frames).

Note: Some Gazebo meshes, model files, world files, and structure are based on
or inspired by TU Dortmund RoboRacer/F1TENTH reference files, where applicable.
Third-party assets remain subject to their original license terms.

Hierarchy (matches f110_car.urdf):
  base_link -> chassis
  chassis -> left_steering -> left_wheel_front
  chassis -> right_steering -> right_wheel_front
  chassis -> left_wheel_back
  chassis -> right_wheel_back
  chassis -> steering_wheel, camera, laser, imu_link

Geometry facts (from the URDF):
  wheelbase (front<->rear axle) : 0.32 m
  kingpin / wheel separation    : 0.211 m
  wheel radius                  : 0.05 m

SDF FRAME CONVENTION (important):
  In SDFormat a <joint><pose> is expressed in the CHILD link frame by default
  (unlike URDF, where <joint><origin> is in the PARENT frame). This model
  follows the idiomatic Ignition pattern:
    * every link carries its pose in the MODEL frame;
    * every joint frame coincides with its child-link frame, so the joint
      <pose> is identity (omitted);
    * the <axis><xyz> of a joint is expressed in the joint (= child-link)
      frame, expressed_in="__model__" is NOT used, so we set the axis in the
      child frame directly. Because all these frames are rotation-aligned
      (identity rpy), the URDF axis vectors carry over unchanged.
-->
<sdf version="1.9">
  <model name="f110_car">

    <!-- ================= base_link (chassis offset frame) ================= -->
    <link name="base_link">
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia>
      </inertial>
    </link>

    <link name="chassis">
      <pose relative_to="base_link">0.16 0 0.05 0 0 0</pose>
      <inertial>
        <mass>3.5</mass>
        <pose>0 0 0.0225 0 0 0</pose>
        <inertia>
          <ixx>0.012375</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.073208</iyy><iyz>0</iyz>
          <izz>0.079567</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <pose>0 0 0.0225 0 0 0</pose>
        <geometry><box><size>0.49 0.18 0.1</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry>
          <mesh><uri>model://f110_car/meshes/car.dae</uri></mesh>
        </geometry>
      </visual>
    </link>
    <joint name="base_link_joint" type="fixed">
      <parent>base_link</parent>
      <child>chassis</child>
    </joint>

    <!-- ================= steering wheel (cosmetic) ================= -->
    <link name="steering_wheel">
      <pose relative_to="chassis">0.105 0 0.135 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>1.667e-6</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>1.667e-6</iyy><iyz>0</iyz><izz>1.667e-6</izz></inertia>
      </inertial>
      <collision name="sw_col"><geometry><box><size>0.01 0.01 0.01</size></box></geometry></collision>
      <visual name="sw_vis"><geometry><box><size>0.01 0.01 0.01</size></box></geometry></visual>
    </link>
    <joint name="steering_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>steering_wheel</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-7.85</lower><upper>7.85</upper>
               <effort>10000000</effort><velocity>1000000</velocity></limit>
      </axis>
    </joint>

    <!-- ================= front-left steering + wheel ================= -->
    <link name="left_steering">
      <pose relative_to="chassis">0.16 0.1055 0 0 0 0</pose>
      <inertial>
        <mass>0.07</mass>
        <inertia><ixx>4.667e-6</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>4.667e-6</iyy><iyz>0</iyz><izz>4.667e-6</izz></inertia>
      </inertial>
      <visual name="ls_vis">
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
      </visual>
    </link>
    <joint name="left_steering_hinge" type="revolute">
      <parent>chassis</parent>
      <child>left_steering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.0</lower><upper>1.0</upper>
               <effort>10</effort><velocity>100</velocity></limit>
      </axis>
    </joint>

    <link name="left_wheel_front">
      <pose relative_to="left_steering">0 0.001 0 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <pose>0 0.02 0 1.5707 0 0</pose>
        <inertia><ixx>0.00013</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.00013</iyy><iyz>0</iyz><izz>0.00025</izz></inertia>
      </inertial>
      <collision name="lwf_col">
        <pose>0 0.02 0 1.5707 0 0</pose>
        <geometry><cylinder><length>0.045</length><radius>0.05</radius></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="lwf_vis">
        <pose>0 0.02 0 0 0 3.14159</pose>
        <geometry><mesh><uri>model://f110_car/meshes/wheel.dae</uri></mesh></geometry>
      </visual>
    </link>
    <joint name="left_wheel_front_hinge" type="revolute">
      <parent>left_steering</parent>
      <child>left_wheel_front</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper>
               <effort>20</effort><velocity>500</velocity></limit>
      </axis>
    </joint>

    <!-- ================= front-right steering + wheel ================= -->
    <link name="right_steering">
      <pose relative_to="chassis">0.16 -0.1055 0 0 0 0</pose>
      <inertial>
        <mass>0.07</mass>
        <inertia><ixx>4.667e-6</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>4.667e-6</iyy><iyz>0</iyz><izz>4.667e-6</izz></inertia>
      </inertial>
      <visual name="rs_vis">
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
      </visual>
    </link>
    <joint name="right_steering_hinge" type="revolute">
      <parent>chassis</parent>
      <child>right_steering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.0</lower><upper>1.0</upper>
               <effort>10</effort><velocity>100</velocity></limit>
      </axis>
    </joint>

    <link name="right_wheel_front">
      <pose relative_to="right_steering">0 -0.001 0 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <pose>0 -0.02 0 1.5707 0 0</pose>
        <inertia><ixx>0.00013</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.00013</iyy><iyz>0</iyz><izz>0.00025</izz></inertia>
      </inertial>
      <collision name="rwf_col">
        <pose>0 -0.02 0 1.5707 0 0</pose>
        <geometry><cylinder><length>0.045</length><radius>0.05</radius></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="rwf_vis">
        <pose>0 -0.02 0 0 0 0</pose>
        <geometry><mesh><uri>model://f110_car/meshes/wheel.dae</uri></mesh></geometry>
      </visual>
    </link>
    <joint name="right_wheel_front_hinge" type="revolute">
      <parent>right_steering</parent>
      <child>right_wheel_front</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper>
               <effort>20</effort><velocity>500</velocity></limit>
      </axis>
    </joint>

    <!-- ================= rear-left wheel ================= -->
    <link name="left_wheel_back">
      <pose relative_to="chassis">-0.16 0.1055 0 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <pose>0 0.021 0 1.5707 0 0</pose>
        <inertia><ixx>0.00013</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.00013</iyy><iyz>0</iyz><izz>0.00025</izz></inertia>
      </inertial>
      <collision name="lwb_col">
        <pose>0 0.021 0 1.5707 0 0</pose>
        <geometry><cylinder><length>0.045</length><radius>0.05</radius></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="lwb_vis">
        <pose>0 0.021 0 0 0 3.14159</pose>
        <geometry><mesh><uri>model://f110_car/meshes/wheel.dae</uri></mesh></geometry>
      </visual>
    </link>
    <joint name="left_wheel_back_hinge" type="revolute">
      <parent>chassis</parent>
      <child>left_wheel_back</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper>
               <effort>20</effort><velocity>500</velocity></limit>
      </axis>
    </joint>

    <!-- ================= rear-right wheel ================= -->
    <link name="right_wheel_back">
      <pose relative_to="chassis">-0.16 -0.1055 0 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <pose>0 -0.021 0 1.5707 0 0</pose>
        <inertia><ixx>0.00013</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.00013</iyy><iyz>0</iyz><izz>0.00025</izz></inertia>
      </inertial>
      <collision name="rwb_col">
        <pose>0 -0.021 0 1.5707 0 0</pose>
        <geometry><cylinder><length>0.045</length><radius>0.05</radius></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="rwb_vis">
        <pose>0 -0.021 0 0 0 0</pose>
        <geometry><mesh><uri>model://f110_car/meshes/wheel.dae</uri></mesh></geometry>
      </visual>
    </link>
    <joint name="right_wheel_back_hinge" type="revolute">
      <parent>chassis</parent>
      <child>right_wheel_back</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper>
               <effort>20</effort><velocity>500</velocity></limit>
      </axis>
    </joint>

    <!-- ================= camera link + depth camera ================= -->
    <link name="camera">
      <pose relative_to="chassis">0.21 0 0.075 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>2.4e-4</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>9.5e-6</iyy><iyz>0</iyz><izz>2.4e-4</izz></inertia>
      </inertial>
      <collision name="cam_col"><geometry><box><size>0.03 0.17 0.03</size></box></geometry></collision>
      <visual name="cam_vis">
        <pose>0 0 0 0 0 1.57</pose>
        <geometry><mesh><uri>model://f110_car/meshes/realsense.dae</uri></mesh></geometry>
      </visual>

      <!-- RGBD camera (matches RealSense D435 spec). topic=camera gives:
             /camera/image         (rgb)
             /camera/depth_image   (depth)
             /camera/camera_info
             /camera/points -->
      <sensor name="realsense_d435" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>camera</topic>
        <gz_frame_id>camera_color_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.2113</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.105</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>chassis</parent>
      <child>camera</child>
    </joint>

    <!-- Optical frame: z forward, x right, y down (camera image convention) -->
    <link name="camera_color_optical_frame">
      <pose relative_to="camera">0 0 0 -1.5708 0 -1.5708</pose>
       <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia>
      </inertial>
    </link>
    <joint name="camera_optical_joint" type="fixed">
      <parent>camera</parent>
      <child>camera_color_optical_frame</child>
    </joint>

    <!-- ================= lidar ================= -->
    <link name="laser">
      <pose relative_to="chassis">0.21 0 0.135 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <pose>0 0 0.0225 0 0 0</pose>
        <inertia><ixx>1.67e-4</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>1.67e-4</iyy><iyz>0</iyz><izz>1.67e-4</izz></inertia>
      </inertial>
      <collision name="laser_col">
        <pose>0 0 0.0225 0 0 0</pose>
        <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
      </collision>
      <visual name="laser_vis">
        <pose>0 0 0.0225 0 0 0</pose>
        <geometry><mesh><uri>model://f110_car/meshes/hokuyo.dae</uri></mesh></geometry>
      </visual>

      <!-- 2D LiDAR (Hokuyo): 1080 samples, +-135 deg, 0.2..30 m
           gz_frame_id forces the ROS LaserScan frame to match the URDF TF
           link name "laser" (Ignition would otherwise scope it). -->
      <sensor name="laser" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>60</update_rate>
        <visualize>false</visualize>
        <topic>scan</topic>
        <gz_frame_id>laser</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1080</samples>
              <resolution>1</resolution>
              <min_angle>-2.35619</min_angle>
              <max_angle>2.35619</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.2</min>
            <max>30</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name="laser_joint" type="fixed">
      <parent>chassis</parent>
      <child>laser</child>
    </joint>

    <!-- ================= imu ================= -->
    <link name="imu_link">
      <pose relative_to="chassis">0 0 0.135 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1.667e-7</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>1.667e-7</iyy><iyz>0</iyz><izz>1.667e-7</izz></inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <visualize>false</visualize>
        <topic>imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent>chassis</parent>
      <child>imu_link</child>
    </joint>

    <!-- =================================================================
         IGNITION SYSTEMS (model-scoped)
         ================================================================= -->

    <!-- Ackermann drive: subscribes to Twist on /cmd_vel -->
    <plugin filename="ignition-gazebo-ackermann-steering-system"
            name="ignition::gazebo::systems::AckermannSteering">
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>100</odom_publish_frequency>

      <left_steering_joint>left_steering_hinge</left_steering_joint>
      <right_steering_joint>right_steering_hinge</right_steering_joint>
      <left_joint>left_wheel_back_hinge</left_joint>
      <right_joint>right_wheel_back_hinge</right_joint>

      <steering_limit>0.6458</steering_limit>
      <steer_p_gain>10.0</steer_p_gain>
      <wheel_base>0.32</wheel_base>
      <kingpin_width>0.211</kingpin_width>
      <wheel_separation>0.211</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <max_velocity>10.0</max_velocity>
      <min_acceleration>-10.0</min_acceleration>
      <max_acceleration>10.0</max_acceleration>
    </plugin>

    <!-- Joint state publisher -> /joint_states -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_front_hinge</joint_name>
      <joint_name>right_wheel_front_hinge</joint_name>
      <joint_name>left_wheel_back_hinge</joint_name>
      <joint_name>right_wheel_back_hinge</joint_name>
      <joint_name>left_steering_hinge</joint_name>
      <joint_name>right_steering_hinge</joint_name>
      <joint_name>steering_wheel_joint</joint_name>
    </plugin>

  </model>
</sdf>
