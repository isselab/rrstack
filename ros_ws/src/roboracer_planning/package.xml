<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roboracer_planning</name>
  <version>0.1.0</version>
  <description>Cone-based local planning for the RoboRacer stack: colour-constrained Delaunay waypoints from YOLO cone detections, followed by a centreline PID or a waypoint pure-pursuit controller.</description>
  <maintainer email="tarunbhyri9@todo.todo">tarunbhyri9</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>ackermann_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>roboracer_gazebo</exec_depend>
  <exec_depend>roboracer_perception</exec_depend>
  <exec_depend>roboracer_drive_to_cmd_vel</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
