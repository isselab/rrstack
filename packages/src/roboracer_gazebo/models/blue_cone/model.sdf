<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="blue_cone">
    <static>true</static>

    <link name="cone_link">

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://blue_cone/meshes/cone_mesh.dae</uri>
            <scale>0.65 0.65 0.65</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://blue_cone/meshes/cone_mesh.dae</uri>
            <scale>0.65 0.65 0.65</scale>
          </mesh>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>